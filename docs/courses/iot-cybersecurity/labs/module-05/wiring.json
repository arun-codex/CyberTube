{
  "module": 5,
  "title": "Calibrated DHT22 / BME280 Environmental Telemetry & Tamper Filtering",
  "maxVoltageDC": 3.3,
  "commonGroundRequired": true,
  "connections": [
    {
      "from": "ESP32_3V3",
      "to": "BREADBOARD_VCC_RAIL",
      "color": "RED",
      "signal": "3.3V_POWER"
    },
    {
      "from": "ESP32_GND",
      "to": "BREADBOARD_GND_RAIL",
      "color": "BLACK",
      "signal": "GROUND"
    },
    {
      "from": "ESP32_GPIO21",
      "to": "BME280_SDA",
      "color": "GREEN",
      "signal": "I2C_DATA_3V3"
    },
    {
      "from": "ESP32_GPIO22",
      "to": "BME280_SCL",
      "color": "WHITE",
      "signal": "I2C_CLOCK_3V3"
    }
  ]
}