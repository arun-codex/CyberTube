# -----------------------------------------------------------------------------
# CyberTube — Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real secrets to Git.

# Canonical Site URL (Used for OAuth callback generation, sitemaps, and redirects)
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production deployment (set in Vercel project environment variables):
# NEXT_PUBLIC_SITE_URL=https://cybertube-mu.vercel.app

# Supabase Project Configuration (Browser and Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase Server-Only Secret (Bypasses RLS for administrative actions)
# NEVER prefix with NEXT_PUBLIC_ or expose to client-side bundles.
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Comma-separated list of authorized administrator emails
# Server-side authorization checks match verified user email against this list.
CYBERTUBE_ADMIN_EMAILS=admin@cybertube.org,secops@cybertube.org

# Google Search Console HTML-Tag Verification Token
# Required for Google Cloud OAuth Branding Verification (domain ownership proof).
# Obtain this token from Google Search Console (URL Prefix property -> HTML tag verification).
# Set in Vercel Production Environment Variables. Leave empty if unconfigured.
GOOGLE_SITE_VERIFICATION=
